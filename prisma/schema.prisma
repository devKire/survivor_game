generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["limiar"]
}

model User {
  id                   String                    @id
  name                 String
  email                String                    @unique
  emailVerified        Boolean                   @default(false)
  image                String?
  username             String?                   @unique
  displayUsername      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  lastSeenAt           DateTime?
  sessions             Session[]
  accounts             Account[]
  progress             UserProgress?
  currencyTransactions CurrencyTransaction[]
  cosmetics            UserCosmetic[]
  echoes               EchoState?
  echoPurchases        EchoPurchase[]
  echoFragments        EchoFragmentTransaction[]
  arenaGames           ArenaParticipant[]
  arenaSeat            ArenaSeat?
  ratings              RankedRating[]
  seasonRewards        SeasonReward[]
  arenaReports         ArenaReport[]
  sentRequests         Friendship[]              @relation("from")
  receivedRequests     Friendship[]              @relation("to")
  memberships          TeamMember[]
  messages             ChatMessage[]             @relation("sender")
  receivedMessages     ChatMessage[]             @relation("recipient")
  games                GameSessionMember[]
  rpgProfile           RpgProfile?

  @@schema("limiar")
}

model RpgProfile {
  userId            String               @id
  revision          Int                  @default(1)
  activeCharacterId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCharacter   RpgCharacter?        @relation("ActiveRpgCharacter", fields: [activeCharacterId, userId], references: [id, userId])
  characters        RpgCharacter[]       @relation("RpgProfileCharacters")
  items             RpgItemInstance[]
  materials         RpgMaterialBalance[]
  mutationReceipts  RpgMutationReceipt[]
  discoveredPois    RpgDiscoveredPoi[]

  @@unique([activeCharacterId, userId])
  @@schema("limiar")
}

model RpgCharacter {
  id            String            @id @default(cuid())
  userId        String
  characterId   String
  level         Int               @default(1)
  xp            Int               @default(0)
  attributePoints Int             @default(0)
  attributes    Json              @default("{\"vitality\":0,\"power\":0,\"agility\":0,\"focus\":0,\"will\":0}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profile       RpgProfile        @relation("RpgProfileCharacters", fields: [userId], references: [userId], onDelete: Cascade)
  activeFor     RpgProfile?       @relation("ActiveRpgCharacter")
  equippedItems RpgItemInstance[] @relation("RpgEquippedItems")
  expeditions   RpgExpeditionParticipant[]
  explorations  RpgExplorationParticipant[]

  @@unique([userId, characterId])
  @@unique([id, userId])
  @@index([userId, level])
  @@schema("limiar")
}

model RpgItemInstance {
  id                  String        @id @default(cuid())
  userId              String
  itemId              String
  rarity              String
  level               Int           @default(1)
  quantity            Int           @default(1)
  contentVersion      Int           @default(1)
  rollSeed            String?
  affixes             Json          @default("[]")
  location            String        @default("INVENTORY")
  equippedCharacterId String?
  equippedSlot        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  profile             RpgProfile    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  equippedCharacter   RpgCharacter? @relation("RpgEquippedItems", fields: [equippedCharacterId, userId], references: [id, userId])

  @@unique([equippedCharacterId, equippedSlot])
  @@index([userId, itemId])
  @@index([userId, location])
  @@schema("limiar")
}

model RpgMaterialBalance {
  userId     String
  materialId String
  amount     Int        @default(0)
  updatedAt  DateTime   @updatedAt
  profile    RpgProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, materialId])
  @@schema("limiar")
}

model RpgMutationReceipt {
  id          String     @id @default(cuid())
  userId      String
  requestId   String
  operation   String
  payloadHash String
  revision    Int
  result      Json
  createdAt   DateTime   @default(now())
  profile     RpgProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@schema("limiar")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("limiar")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @map("passwordHash")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@schema("limiar")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@schema("limiar")
}

model UserProgress {
  userId         String   @id
  version        Int      @default(1)
  data           Json
  localArchive   Json?
  importResolved Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("limiar")
}

model Friendship {
  id        String   @id @default(cuid())
  pair      String   @unique
  fromId    String
  toId      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  from      User     @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, status])
  @@index([toId, status])
  @@schema("limiar")
}

model Team {
  id        String        @id @default(cuid())
  code      String        @unique
  leaderId  String
  expiresAt DateTime
  status    String        @default("LOBBY")
  mapId     String        @default("ruins")
  mode      String        @default("normal")
  duration  Int           @default(1800)
  expeditionKind String  @default("SURVIVOR")
  createdAt DateTime      @default(now())
  members   TeamMember[]
  messages  ChatMessage[]
  games     GameSession[]

  @@schema("limiar")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String   @unique
  slot      Int
  character String   @default("nara")
  ready     Boolean  @default(false)
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, slot])
  @@schema("limiar")
}

model ChatMessage {
  id           String      @id @default(cuid())
  senderId     String
  recipientId  String?
  teamId       String?
  arenaMatchId String?
  text         String
  createdAt    DateTime    @default(now())
  sender       User        @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User?       @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  team         Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  arenaMatch   ArenaMatch? @relation(fields: [arenaMatchId], references: [id], onDelete: Cascade)

  @@index([arenaMatchId, createdAt])
  @@index([teamId, createdAt, id])
  @@index([senderId, recipientId, createdAt, id])
  @@schema("limiar")
}

model GameSession {
  id        String              @id @default(cuid())
  teamId    String
  seed      String
  mapId     String
  mode      String
  duration  Int                 @default(1800)
  partySize Int
  expeditionKind String         @default("SURVIVOR")
  status    String              @default("RUNNING")
  startedAt DateTime            @default(now())
  endedAt   DateTime?
  result    Json?
  team      Team                @relation(fields: [teamId], references: [id])
  members   GameSessionMember[]
  rpgExpedition RpgExpeditionSession?
  rpgExploration RpgExplorationSession?

  @@unique([id, expeditionKind])
  @@schema("limiar")
}

model GameSessionMember {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  character String
  result    Json?
  reward    Int         @default(0)
  survived  Boolean     @default(false)
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rpgParticipant RpgExpeditionParticipant?
  explorationParticipant RpgExplorationParticipant?

  @@unique([sessionId, userId])
  @@unique([sessionId, userId, character])
  @@schema("limiar")
}

model RpgExpeditionSession {
  sessionId      String @id
  expeditionKind String @default("RPG_EXPEDITION")
  rewardVersion  Int    @default(1)
  profileId      String @default("ruins-v1")
  rewardSeed     String
  status         String @default("RUNNING")
  terminal       Json?
  terminalHash   String?
  terminalAt     DateTime?
  settledAt      DateTime?
  createdAt      DateTime @default(now())
  session        GameSession @relation(fields: [sessionId, expeditionKind], references: [id, expeditionKind], onDelete: Cascade)
  participants   RpgExpeditionParticipant[]

  @@unique([sessionId, expeditionKind])
  @@index([status, createdAt])
  @@schema("limiar")
}

model RpgExpeditionParticipant {
  sessionId      String
  userId         String
  characterId    String
  entryRevision  Int
  entryLevel     Int
  loadout        Json
  loadoutHash    String
  eligibility    String @default("PENDING")
  activeUserId   String? @unique
  createdAt      DateTime @default(now())
  session        RpgExpeditionSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  member         GameSessionMember @relation(fields: [sessionId, userId, characterId], references: [sessionId, userId, character], onDelete: Cascade)
  character      RpgCharacter @relation(fields: [userId, characterId], references: [userId, characterId], onDelete: Cascade)
  receipt        RpgRewardReceipt?

  @@id([sessionId, userId])
  @@unique([sessionId, userId, characterId])
  @@index([userId, createdAt, sessionId])
  @@schema("limiar")
}

model RpgRewardReceipt {
  sessionId      String
  userId         String
  characterId    String
  xpGranted      Int
  previousLevel  Int
  newLevel       Int
  pointsGranted  Int
  result         Json
  createdAt      DateTime @default(now())
  participant    RpgExpeditionParticipant @relation(fields: [sessionId, userId, characterId], references: [sessionId, userId, characterId], onDelete: Cascade)

  @@id([sessionId, userId])
  @@unique([sessionId, userId, characterId])
  @@schema("limiar")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@schema("limiar")
}

model CurrencyTransaction {
  id           String   @id @default(cuid())
  userId       String
  currency     String
  amount       Int
  type         String
  source       String
  referenceId  String
  balanceAfter Int
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, referenceId])
  @@index([userId, createdAt])
  @@index([source, createdAt])
  @@schema("limiar")
}

model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  cosmeticId String
  source     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@schema("limiar")
}

model EchoState {
  userId    String @id
  rare      Int    @default(0)
  epic      Int    @default(0)
  legendary Int    @default(0)
  fragments Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("limiar")
}

model EchoPurchase {
  id        String   @id @default(cuid())
  userId    String
  requestId String
  banner    String
  currency  String
  cost      Int
  count     Int
  results   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@schema("limiar")
}

model EchoFragmentTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  referenceId String
  source      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceId])
  @@schema("limiar")
}

model ArenaMatch {
  id           String             @id @default(cuid())
  mode         String
  seasonId     String?
  status       String             @default("RUNNING")
  startedAt    DateTime           @default(now())
  endedAt      DateTime?
  winner       Int?
  result       Json?
  events       Json?
  participants ArenaParticipant[]
  seats        ArenaSeat[]
  season       Season?            @relation(fields: [seasonId], references: [id])
  reports      ArenaReport[]
  chat         ChatMessage[]

  @@schema("limiar")
}

model ArenaParticipant {
  id        String     @id @default(cuid())
  matchId   String
  userId    String
  team      Int
  character String
  result    Json?
  match     ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([userId])
  @@schema("limiar")
}

model ArenaSeat {
  userId  String     @id
  matchId String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  match   ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@schema("limiar")
}

model Season {
  id       String         @id
  name     String
  startsAt DateTime
  endsAt   DateTime
  ratings  RankedRating[]
  matches  ArenaMatch[]
  rewards  SeasonReward[]

  @@schema("limiar")
}

model RankedRating {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String
  mode      String
  mmr       Int      @default(1000)
  peak      Int      @default(1000)
  games     Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season    Season   @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId, mode])
  @@index([seasonId, mode, mmr])
  @@schema("limiar")
}

model SeasonReward {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String
  mode      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season    Season   @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId, mode])
  @@schema("limiar")
}

model ArenaReport {
  id        String     @id @default(cuid())
  userId    String
  targetId  String
  matchId   String
  reason    String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, matchId])
  @@schema("limiar")
}

model RpgExplorationSession {
  sessionId String @id
  expeditionKind String @default("RPG_EXPLORATION")
  regionId String
  regionVersion Int
  generationVersion Int @default(1)
  worldVersion Int @default(3)
  rulesVersion Int @default(1)
  status String @default("RUNNING")
  createdAt DateTime @default(now())
  endedAt DateTime?
  session GameSession @relation(fields: [sessionId, expeditionKind], references: [id, expeditionKind], onDelete: Cascade)
  participants RpgExplorationParticipant[]
  @@unique([sessionId, expeditionKind])
  @@index([status, createdAt])
  @@schema("limiar")
}
model RpgExplorationParticipant {
  sessionId String
  userId String
  characterId String
  loadout Json
  loadoutHash String
  activeUserId String? @unique
  leftAt DateTime?
  session RpgExplorationSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  member GameSessionMember @relation(fields: [sessionId, userId, characterId], references: [sessionId, userId, character], onDelete: Cascade)
  character RpgCharacter @relation(fields: [userId, characterId], references: [userId, characterId], onDelete: Cascade)
  claims RpgResourceClaim[]
  @@unique([sessionId, userId, characterId])
  @@id([sessionId, userId])
  @@index([userId, sessionId])
  @@schema("limiar")
}
model RpgResourceClaim {
  id String @id @default(cuid())
  sessionId String
  userId String
  regionId String
  regionVersion Int
  nodeId String
  cycle Int
  rulesVersion Int @default(1)
  requestId String
  payloadHash String
  materialId String
  quantity Int
  revision Int
  createdAt DateTime @default(now())
  participant RpgExplorationParticipant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade)
  @@unique([userId, regionId, regionVersion, nodeId, cycle])
  @@unique([userId, requestId])
  @@index([userId, cycle])
  @@index([sessionId, userId])
  @@index([userId, createdAt, id])
  @@schema("limiar")
}
model RpgDiscoveredPoi {
  userId String
  regionId String
  regionVersion Int
  poiId String
  discoveredAt DateTime @default(now())
  profile RpgProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@id([userId, regionId, regionVersion, poiId])
  @@index([userId, discoveredAt])
  @@schema("limiar")
}
