{
  "name": "limiar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
